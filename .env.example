GFLOW_VERSION=0.43.0
REMOVE_AI_WATERMARKS_VERSION=0.19.0
NOVNC_PORT=7900

# Required. Replace before the first start; never expose noVNC publicly.
NOVNC_PASSWORD=change-this-before-starting

FLOW_CDP_PORT=9223
GEMINI_CDP_PORT=9224

# Leave both blank when the network can reach Google directly.
# macOS proxy example:
# HOST_PROXY=http://127.0.0.1:10808
# CONTAINER_PROXY=http://host.docker.internal:10808
HOST_PROXY=
CONTAINER_PROXY=

REMOVE_VISIBLE_WATERMARKS=true
KEEP_ORIGINALS=false
IMAGE_CLEAN_BACKEND=migan
GFLOW_CLI_HEADLESS=true
GFLOW_CLI_PREFER_CLASSIC=true

# Portable defaults keep generated files and reference inputs in this folder.
# Set absolute host paths when you want to expose a larger project directory.
HOST_OUTPUT_DIR=./outputs
HOST_WORKSPACE_DIR=.
